{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "eza *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -a", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
