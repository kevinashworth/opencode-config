{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "diff *": "allow",
      "echo *": "allow",
      "eza *": "allow",
      "find *": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-remote": "allow",
      "git merge-base *": "allow",
      "git push *": "ask",
      "git show *": "allow",
      "git status *": "allow",
      "git tag": "deny",
      "git tag -l": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "nl *": "allow",
      "npm install *": "ask",
      "npm root": "allow",
      "npm run check:spell *": "allow",
      "npm run check:types *": "allow",
      "npm run lint *": "allow",
      "npm run test *": "allow",
      "npm run test:e2e *": "allow",
      "npm run test:run *": "allow",
      "npm run typecheck *": "allow",
      "npx *": "ask",
      "npx vitest *": "allow",
      "opencode --help": "allow",
      "opencode --version": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "rm *": "deny",
      "sed *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow"
    },
    "codesearch": "ask",
    "doom_loop": "ask",
    "edit": "ask",
    "external_directory": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": "deny",
    "task": {
      "*": "ask",
      "explore": "allow"
    },
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "ask"
  }
}
